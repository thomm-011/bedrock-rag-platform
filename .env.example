RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_OLLAMA_LLM_MODEL=llama3.2:3b
RAG_OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_OLLAMA_NUM_PREDICT=256
RAG_DB_HOST=localhost
RAG_DB_PORT=5432
RAG_DB_USER=rag
RAG_DB_PASSWORD=rag
RAG_DB_NAME=rag
RAG_VECTOR_DIM=768
RAG_DEFAULT_TOP_K=4

# docker compose only (not read by the app):
# OLLAMA_MODELS_DIR=/home/you/.ollama/models   # reuse host-pulled models
# COMPOSE_OLLAMA_URL=http://host.docker.internal:11434  # use host Ollama instead of the compose service
